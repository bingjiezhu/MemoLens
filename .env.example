# Default profiles in config.yaml are MiniMax. Override here if needed.
# VISION_VLM_PROFILE=minimax_vl01
# QUERY_VLM_PROFILE=minimax_m27

# Example: Vertex / Gemini
# VISION_VLM_PROFILE=vertex_gemini25_flash
# QUERY_VLM_PROFILE=vertex_gemini25_flash
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
# VERTEX_ACCESS_TOKEN=

# Example: local Ollama
# VISION_VLM_PROFILE=ollama_gemma4_e4b
# QUERY_VLM_PROFILE=ollama_gemma4_e4b

# Video frames, audio, and transcripts remain local in v0.3.0. Existing photo
# provider keys never authorize video payloads, and there is intentionally no
# environment-only switch that bypasses the desktop consent boundary.

MINIMAX_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OLLAMA_API_KEY=ollama

IMAGE_LIBRARY_DIR=
SQLITE_DB_PATH=
EMBEDDING_BACKEND=semantic_hash
ENABLE_REVERSE_GEOCODE=false
