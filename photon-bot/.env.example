BACKEND_BASE_URL=http://127.0.0.1:5519
IMAGE_LIBRARY_DIR=/absolute/path/to/your/photo/folder
# Copy the exact hashed path from MemoLens Library / Setup, for example:
# SQLITE_DB_PATH=/Users/you/Library/Application Support/MemoLens/storage/photo-index-<hash>.db
SQLITE_DB_PATH=
BACKEND_SEND_PATH_OVERRIDES=true
DISCORD_SEND_IMAGE_WIDTH=512
DISCORD_BOT_TOKEN=
# Required: comma-separated trusted Discord user IDs. Empty makes startup fail closed.
DISCORD_ALLOWED_USER_IDS=
# Optional: comma-separated guild channel IDs. Empty disables all guild messages; allowed-user DMs still work.
DISCORD_ALLOWED_CHANNEL_IDS=
BACKEND_REQUEST_TIMEOUT_MS=180000
DEFAULT_TOP_K=9
DEFAULT_REPLY_IMAGE_COUNT=9
SESSION_TTL_MINUTES=30
LOG_LEVEL=info
