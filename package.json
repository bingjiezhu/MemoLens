{
  "name": "memolens",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:mac": "bash ./scripts/bootstrap_mac.sh",
    "demo:library": "python3 scripts/create_demo_library.py",
    "dev": "vite",
    "dev:local": "bash ./scripts/dev_local.sh",
    "quality:backfill": "python3 scripts/backfill_image_quality.py",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "electron": "npm run build && bash ./scripts/prepare_desktop_runtime.sh && bash ./scripts/run_desktop_runtime.sh",
    "electron:open": "bash ./scripts/prepare_desktop_runtime.sh && bash ./scripts/run_desktop_runtime.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint:python": "ruff check .",
    "audit:deps": "npm audit --audit-level=high && bash ./scripts/run_pip_audit.sh",
    "test:unit": "bash ./scripts/run_python.sh -m unittest discover -s tests -v",
    "test:node": "node --experimental-strip-types --test tests/backend_manager_health.test.mjs tests/indexing_coordinator.test.mjs tests/artifact_integrity.test.mjs tests/video_mutation_ledger.test.mjs tests/video_session.test.mjs tests/video_job_model.test.mjs && npm run test:renderer-models",
    "test:electron": "npm run build:electron && npm run test:node",
    "test:renderer-models": "node --experimental-strip-types --experimental-loader ./tests/ts-extension-loader.mjs --test tests/video_api.test.mjs tests/atlas_basket_model.test.mjs tests/draft_generation.test.mjs",
    "test:video-api": "node --experimental-strip-types --experimental-loader ./tests/ts-extension-loader.mjs --test tests/video_api.test.mjs",
    "test:plugin": "bash ./scripts/run_python.sh -m unittest discover -s .agents/plugins/plugins/memolens/tests -v",
    "test:smoke": "bash ./scripts/run_python.sh scripts/verify_local_deployment.py",
    "verify:local": "bash ./scripts/verify_local.sh",
    "check": "npm run lint:python && npm run test:unit && npm run test:plugin && npm run verify:local && npm run build && npm run test:node"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
